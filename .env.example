# Copy to .env for local development (never commit .env).
APP_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
# Optional locally (defaults to SQLite file ./cf_tracker.db). Required on Railway.
# DATABASE_URL=postgresql://user:pass@localhost:5432/cf_tracker
APP_TIMEZONE=Europe/Berlin
# Background Codeforces sync interval in minutes (0 = off).
CF_SYNC_MINUTES=30
